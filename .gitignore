# build output
/target/
# release packages (packaging/*/package.*)
/dist/
# the web editor built by scripts/build-web.sh (ADR 0036)
/web/
# sample plug-ins built by examples/plugins/build.sh (sources are committed, binaries never)
/examples/plugins/dist/
/examples/plugins/target/

# generated screenshots and exports (regenerate with --screenshot / anicraft-cli)
/shots/
/frames/
*.anicraft.tmp

# editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# parallel milestone worktrees (AGENTS.md › Milestone tracks)
/.worktrees/

# Python bytecode from the Nightly packaging suites (packaging/nightly-tests.py).
__pycache__/

# Nightly packaging (packaging/nightly-common.sh): the shared workflow checks these out into the
# workspace, and `nightly_init` refuses a dirty tree, so they must never be committed.
/.nightly-tools
/.nightly-input
/craft-i18n
/craft-fonts
